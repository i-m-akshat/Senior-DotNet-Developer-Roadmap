BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 587.5 Td (// MISTAKE 1: Async lambda in Parallel.ForEach) Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 578.0 Td (Parallel.ForEach\(urls, async url => {) Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 568.5 Td (    // CATASTROPHIC: This is an async void lambda!) Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 559.0 Td (    // Parallel.ForEach does NOT wait for this to finish!) Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 549.5 Td (    await DownloadUrlAsync\(url\); ) Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 540.0 Td (}\);) Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 530.5 Td (// FIX: In .NET 6+, use Parallel.ForEachAsync:) Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 521.0 Td (await Parallel.ForEachAsync\(urls, async \(url, ct\) => await DownloadUrlAsync\(url\)\);) Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 511.5 Td () Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 502.0 Td (// MISTAKE 2: PLINQ queries modifying shared state without thread-safety) Tj ET
BT /F3 7.5 Tf 0.8 0.88 0.95 rg 58 492.5 Td (var list = new List<int>\(\);) Tj ET
